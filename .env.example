# YakNet y-auth SDK Integration Credentials
# Copy this file to your application's .env file and fill in the credentials.

YAUTH_CLIENT_ID="your-client-id-here"
YAUTH_CLIENT_SECRET="your-client-secret-here"
YAUTH_REDIRECT_URI="https://your-app.com/callback"
YAUTH_BASE_URL="https://auth.yakhub.com.tr"
